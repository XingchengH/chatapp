NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional for local text chat; configure all three for images. Required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Optional; pair with frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Set only when the host's proxy topology is known, e.g. 1 for exactly one trusted proxy.
TRUST_PROXY_HOPS=0
# Optional live video calls. Server credentials must never use VITE_ prefixes.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
